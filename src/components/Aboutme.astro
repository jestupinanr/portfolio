---
import FirstGrid from "./aboutme/FirstGrid.astro";
import SecondGrid from "./aboutme/SecondGrid.astro";
import ThirdGrid from "./aboutme/ThirdGrid.astro";
import { profile } from "../data/profile";
---

<div id="about" class="bg-gray py-8 px-4 sm:px-10 flex flex-col gap-8 scroll-mt-4">
  <h3 class="text-4xl lg:text-5xl text-secondary text-center font-bold">About me</h3>
  <p class="text-fg text-sm lg:text-base leading-relaxed max-w-4xl mx-auto text-center">
    {profile.bio}
  </p>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-3">
    <FirstGrid />
    <SecondGrid />
    <ThirdGrid />
  </div>
</div>
