---
import Card from "./Card.astro";
import trufExample from "../assets/images/example-truf.png";
import winisExample from "../assets/images/example-winis.png";
import trufAdmin from "../assets/images/example-truf-admin.png";
import gws from "../assets/images/example-gws.png";
import ebloqs from "../assets/images/example-ebloqs.png";
import brandforce from "../assets/images/example-brandforce.png";
import { projects } from "../data/profile";

const images = { truf: trufExample, trufAdmin, ebloqs, winis: winisExample, gws, brandforce };
---
<div id="projects" class="flex flex-col gap-7 py-8 px-4 sm:px-10 scroll-mt-4">
  <h3 class="text-4xl lg:text-5xl text-secondary text-center font-bold">Projects</h3>
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
    {projects.map((p) => (
      <Card
        title={p.title}
        description={p.description}
        hrefImage={p.image ? images[p.image] : undefined}
        textOnly={p.textOnly}
        tools={p.tools}
        company={p.company}
        type={p.type}
        href={p.href}
        isPrivate={p.isPrivate}
      />
    ))}
  </div>
</div>
