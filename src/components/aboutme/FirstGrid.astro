---
import profileImg from "../../assets/images/profile.webp";
import Button from "../common/Button.astro";
import { profile, contact, stats } from "../../data/profile";

const whatsappHref = contact.whatsapp || undefined;
---

<div class="flex flex-col gap-5">
    <!-- stats -->
    <div class="grid grid-cols-3 gap-3 lg:gap-5">
      {stats.map((stat) => (
        <div class="bg-primary rounded-[20px] flex flex-col justify-center items-center text-fg font-extrabold relative py-3 px-1 drop-shadow text-center">
          <p class={`gradient-text ${stat.small ? "text-xl lg:text-2xl py-5" : "text-[48px] lg:text-[64px]"}`}>{stat.value}</p>
          <span class="text-[10px] lg:text-xs leading-tight">{stat.label}</span>
        </div>
      ))}
    </div>
    <!-- my information -->
    <div class="bg-primary rounded-[20px] drop-shadow py-5 flex flex-col px-5 gap-5">
      <div class="flex gap-3">
        <img
          src={profileImg.src}
          alt={`Photo of ${profile.name}`}
          class="w-32 h-32 rounded-full"
        />
        <div class="flex flex-col gap-4 justify-center">
          <div class="flex bg-chip rounded-md gap-2 px-2 py-1 justify-center items-center">
            <div class="w-2 h-2 bg-green rounded-full"></div>
            <span class="text-[10px] text-fg font-normal">{profile.status}</span>
          </div>
          <div class="flex flex-col gap-2">
            <p class="text-fg text-sm">{profile.name}</p>
            <p class="text-muted text-xs">{profile.role}</p>
          </div>
        </div>
      </div>
      <div class="bg-inset rounded-[10px] w-full py-2 px-4 flex flex-wrap gap-2 lg:gap-4">
        {profile.tags.map((tag) => (
          <div class="bg-chip rounded-[5px] font-normal text-fg text-[10px] px-2 py-0.5">
            <span>{tag}</span>
          </div>
        ))}
      </div>
      <div id="contact" class="grid grid-cols-2 gap-3 scroll-mt-4">
        <Button text="WhatsApp" href={whatsappHref} external />
        <Button text="Email" href={`mailto:${contact.email}`} />
        <div class="col-span-2">
          <Button text="Download CV" href={contact.cv} variant="solid" download />
        </div>
      </div>
    </div>
  </div>
