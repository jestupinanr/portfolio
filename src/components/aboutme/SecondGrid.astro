---
import linkedin from "../../assets/icons/linkedin-v2.svg";
import github from "../../assets/icons/github-v2.svg";
import { contact, skills, toolLabels } from "../../data/profile";
import { toolIcons } from "../../data/icons";

const links = [
  { name: "LinkedIn", href: contact.linkedin, icon: linkedin },
  { name: "GitHub", href: contact.github, icon: github },
];
---

<div class="flex flex-col gap-7">
  <div class="bg-primary rounded-[20px] drop-shadow">
    <div class="flex items-center justify-center py-11 gap-7">
      {links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="bg-chip flex px-3 py-1 items-center rounded-[5px] gap-3 hover:opacity-80 transition"
        >
          <div class="bg-[#5E5E5E] rounded-[10px]">
            <img src={l.icon.src} alt="" class="w-9 h-9" />
          </div>
          <p class="text-muted text-[15px]">{l.name}</p>
        </a>
      ))}
    </div>
  </div>

  <!-- tools -->
  <div class="grid grid-cols-5 gap-3 lg:gap-6">
    {skills.map((tool) => (
      <div
        class="bg-primary rounded-[20px] flex justify-center items-center py-4 px-1 drop-shadow"
        title={toolLabels[tool]}
      >
        <img
          src={toolIcons[tool].src}
          alt={toolLabels[tool]}
          class="w-6 h-6 lg:w-9 lg:h-9"
        />
      </div>
    ))}
  </div>
</div>
