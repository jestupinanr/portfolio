---
import { experience } from "../../data/profile";
---

<div class="flex flex-col gap-5">
  {experience.map((job) => (
    <div class="bg-primary rounded-[20px] flex flex-col px-4 py-4 drop-shadow gap-3">
      <div>
        <p class="text-fg text-base font-bold">{job.company}</p>
        {job.summary && <p class="text-muted text-[10px]">{job.summary}</p>}
      </div>
      {job.roles.map((role) => (
        <details class="group border-t border-gray pt-3">
          <summary class="cursor-pointer list-none flex justify-between gap-3 items-start">
            <span class="text-fg text-sm">{role.title}</span>
            <span class="gradient-text font-extrabold text-xs whitespace-nowrap">{role.dates}</span>
          </summary>
          <ul class="list-disc pl-4 mt-2 flex flex-col gap-1 text-muted text-[11px] leading-snug">
            {role.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </details>
      ))}
    </div>
  ))}
</div>
