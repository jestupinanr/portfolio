---
import bannerPhoto from '../assets/images/banner-photo.webp';
import Button from './common/Button.astro';
import { profile, contact } from '../data/profile';
---
<section
  id="home"
  class="max-w-full overflow-hidden rounded-2xl lg:max-h-[100vh] w-screen grid grid-cols-1 sm:grid-cols-2"
>
  <div class="flex flex-col pt-16 lg:pt-28 px-6 sm:pl-14 sm:pr-10 gap-8 lg:gap-16 pb-11 order-2 sm:order-1">
    <div class="flex flex-col gap-4 lg:gap-6">
      <h1 class="font-bold text-3xl lg:text-5xl text-secondary">
        Hi, I'm {profile.firstName}.
      </h1>
      <p class="text-3xl lg:text-5xl text-fg font-bold leading-tight lg:leading-[5.25rem]">
        {profile.role}
      </p>
      <p class="text-sm lg:text-base text-muted">{profile.subtitle}</p>
    </div>
    <h2 class="text-base lg:text-xl text-fg sm:text-center">
      {profile.tagline}
    </h2>
    <div class="flex flex-wrap justify-center items-center gap-3">
      <Button text="Contact" href="#contact" />
      <Button text="Download CV" href={contact.cv} variant="solid" download />
      <Button text="LinkedIn" href={contact.linkedin} external />
    </div>
  </div>
  <div class="bg-secondary flex justify-center items-end order-1 sm:order-2 pt-10 sm:pt-0">
    <img
      src={bannerPhoto.src}
      alt={`Portrait of ${profile.name}`}
      class="w-52 h-52 lg:w-[27rem] lg:h-[30rem] object-contain"
    />
  </div>
</section>
