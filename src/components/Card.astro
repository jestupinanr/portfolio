---
import { toolIcons } from '../data/icons';
import { toolLabels, type Tool } from '../data/profile';

interface Props {
  title: string;
  tools: Tool[];
  hrefImage?: ImageMetadata;
  urlPhone?: ImageMetadata;
  description: string;
  className?: string;
  type?: 'small' | 'big';
  href?: string;
  company?: string;
  isPrivate?: boolean;
  textOnly?: boolean;
}

const { hrefImage, title, tools, urlPhone, description, className, type, href, company, isPrivate, textOnly } = Astro.props;
const Wrapper = href ? 'a' : 'div';
const wrapperProps = href ? { href, target: '_blank', rel: 'noopener noreferrer', 'aria-label': `${title} (opens in a new tab)` } : {};
const meta = [company, ...tools.slice(0, 3).map((t) => toolLabels[t])].filter(Boolean).join(' · ');
---

<style>
.inner-shadow {
  position: relative;
}
.inner-shadow::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  box-shadow: inset 0 -46px 35px rgb(255 171 0 / 13%);
  z-index: 10; /* Asegura que esté encima de los demás contenidos */
  pointer-events: none; /* Permite interactuar con los elementos debajo de la sombra */
}
</style>

<Wrapper {...wrapperProps} class={`bg-gray rounded-[20px] pt-8 max-h-[420px] lg:max-h-[550px] ${textOnly ? 'pb-8 !max-h-none lg:col-span-3 px-6' : ''} w-full overflow-x-hidden
	overflow-y-hidden relative ${href ? 'cursor-pointer' : ''} hover:shadow-2xl transition duration-300 ease-in-out
	hover:scale-y-[1.01] group ${className} inner-shadow drop-shadow flex flex-col ${type === 'small' ? 'items-end': 'items-center'} `}
  >
	<p class="font-normal text-3xl lg:text-4xl leading-tight w-full text-center
		transform transition delay-150 duration-300 ease-in-out group-hover:-translate-y-4 text-fg"
	>
	  {title}
	  {isPrivate && <span class="ml-2 align-middle text-[10px] border border-muted text-muted rounded px-1.5 py-0.5">Private project</span>}
	</p>
  <p class="font-normal text-base leading-tight w-full text-center px-3
		transform transition delay-150 duration-300 ease-in-out group-hover:-translate-y-4 text-muted"
	>
	  {description}
	</p>
  <p class="text-xs text-muted w-full text-center mt-1">{meta}</p>
	<div class="w-full flex flex-wrap justify-end gap-2 pr-7 mt-2">
	  {tools.map((tool) => (
      <div class="w-6 h-6 lg:w-9 lg:h-9 rounded-full bg-white flex justify-center items-center animate-hide-in-up opacity-0
        group-hover:animate-fade-in-up group-hover:opacity-100 z-10 delay-1000">
        <img
          src={toolIcons[tool].src}
          alt={toolLabels[tool]}
          class="w-4 h-4 lg:w-6 lg:h-6"
        />
      </div>
    ))}
	</div>
	{hrefImage && <img
	  src={hrefImage.src}
	  alt={`${title} preview`}
	  class={`relative delay-300 z-0 ${type === 'small' ? 'w-72' : 'w-full max-w-[30rem]'}  h-60
	  transform transition duration-300 ease-in-out group-hover:translate-y-4`}
	/>}
  {urlPhone && (
    <img
      src={urlPhone.src}
      alt=""
      class="hidden lg:block absolute bottom-0 -left-0 w-auto h-full max-h-[14rem] z-0
      transform transition duration-300 ease-in-out group-hover:translate-y-4"
    />
  )}
</Wrapper>
